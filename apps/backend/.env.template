STORE_CORS=http://localhost:8000,https://docs.medusajs.com
ADMIN_CORS=http://localhost:5173,http://localhost:9000,https://docs.medusajs.com
AUTH_CORS=http://localhost:5173,http://localhost:9000,https://docs.medusajs.com
REDIS_URL=redis://localhost:6379
JWT_SECRET=supersecret
COOKIE_SECRET=supersecret
DATABASE_URL=
DB_NAME=nanofield
# Storefront cache invalidation after catalog changes (subscriber: revalidate-storefront)
STOREFRONT_URL=http://localhost:8000
REVALIDATE_SECRET=change-me-to-a-long-random-string
# RajaOngkir V2 shipping-cost API (provider: src/modules/rajaongkir-fulfillment)
# Key: Collaborator dashboard -> Developer -> Settings -> Api Key, SHIPPING COST
# key (not payment/QRIS). Sandbox key first for testing; swap base URL too.
RAJAONGKIR_API_KEY=
RAJAONGKIR_BASE_URL=https://rajaongkir.komerce.id/api/v1
# Preferred origin: numeric subdistrict id (one-time lookup). Empty = resolve
# RAJAONGKIR_ORIGIN text through destination search at boot.
RAJAONGKIR_ORIGIN_ID=
RAJAONGKIR_ORIGIN=Jambi
RAJAONGKIR_DEFAULT_WEIGHT_G=500
RAJAONGKIR_FALLBACK_AMOUNT=20000
# Midtrans Snap payment (provider: src/modules/midtrans-payment, id "midtrans").
# Keys: Midtrans dashboard -> Settings -> Access Keys. Sandbox keys first;
# flip IS_PRODUCTION only at go-live with the live keys.
# Notification URL to register in the Midtrans dashboard (per environment):
#   {BACKEND_URL}/hooks/payment/midtrans
# (Medusa core consumes it through the provider's getWebhookActionAndData.)
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false
