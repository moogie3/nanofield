STORE_CORS=http://localhost:8000,https://docs.medusajs.com
ADMIN_CORS=http://localhost:5173,http://localhost:9000,https://docs.medusajs.com
AUTH_CORS=http://localhost:5173,http://localhost:9000,https://docs.medusajs.com
REDIS_URL=redis://localhost:6379
JWT_SECRET=supersecret
COOKIE_SECRET=supersecret
DATABASE_URL=
DB_NAME=nanofield
# Storefront cache invalidation after catalog changes (subscriber: revalidate-storefront)
STOREFRONT_URL=http://localhost:8000
REVALIDATE_SECRET=change-me-to-a-long-random-string
# RajaOngkir V2 shipping-cost API (provider: src/modules/rajaongkir-fulfillment)
# Key: Collaborator dashboard -> Developer -> Settings -> Api Key, SHIPPING COST
# key (not payment/QRIS). Sandbox key first for testing; swap base URL too.
RAJAONGKIR_API_KEY=
RAJAONGKIR_BASE_URL=https://rajaongkir.komerce.id/api/v1
# Preferred origin: numeric subdistrict id (one-time lookup). Empty = resolve
# RAJAONGKIR_ORIGIN text through destination search at boot.
RAJAONGKIR_ORIGIN_ID=
RAJAONGKIR_ORIGIN=Jambi
RAJAONGKIR_DEFAULT_WEIGHT_G=500
RAJAONGKIR_FALLBACK_AMOUNT=20000
# Midtrans Snap payment (provider: src/modules/midtrans-payment, id "midtrans").
# Keys: Midtrans dashboard -> Settings -> Access Keys. Sandbox keys first;
# flip IS_PRODUCTION only at go-live with the live keys.
# Notification URL to register in the Midtrans dashboard (per environment):
#   {BACKEND_URL}/hooks/payment/midtrans
# (Medusa core consumes it through the provider's getWebhookActionAndData.)
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false
# Shipping-label sender block (receipt: GET /admin/orders/[id]/receipt).
# Shown as Pengirim on every printed label; no admin UI edits these yet.
STORE_NAME=Nanofield
STORE_PHONE=+62 851-2155-0532
STORE_ADDRESS_1=Pasar Jambi
STORE_CITY=Jambi
STORE_PROVINCE=Jambi
STORE_COUNTRY_CODE=id
STORE_EMAIL=customer-support@nanofield.com
# Customer email: exactly ONE provider is ever active (see medusa-config.ts).
# Production — Resend (verified sender required):
#   1. Verify ONE address at resend.com (no DNS needed): the address below.
#   2. Paste the API key locally as RESEND_API_KEY (never commit it).
RESEND_API_KEY=
RESEND_FROM=customer-support@nanofield.com
# Development — Mailtrap sandbox (catches everything, delivers nothing):
#   Open the sandbox inbox → SMTP Settings → copy each value below.
#   Active when MAILTRAP_USER is set and RESEND_API_KEY is empty.
MAILTRAP_HOST=sandbox.smtp.mailtrap.io
MAILTRAP_PORT=2525
MAILTRAP_USER=
MAILTRAP_PASS=
MAILTRAP_FROM=customer-support@nanofield.com
# Auto-delivery sync (job: tracking-sync) — polls RajaOngkir AWB tracking for
# shipped-but-undelivered fulfillments and marks them delivered. Shares the
# 100 hits/day free quota with checkout quotes, so defaults stay conservative.
TRACKING_SYNC_ENABLED=true
TRACKING_SYNC_CRON=0 */6 * * *
TRACKING_SYNC_MAX_PER_RUN=5
TRACKING_SYNC_MIN_AGE_HOURS=6

# Feed retention (job: notification-retention) — deletes channel "feed" rows
# (admin bell, customer bell, broadcasts) older than this many days. 0 disables.
FEED_RETENTION_DAYS=90
FEED_RETENTION_CRON=0 3 * * *
